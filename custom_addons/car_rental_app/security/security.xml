<odoo>

    <record id="module_category_car_rental" model="ir.module.category">
        <field name="name">Car Rental</field>
        <field name="sequence">20</field>
    </record>

    <record id="car_rental_privilege" model="res.groups.privilege">
        <field name="name">Car Rental</field>
        <field name="category_id" ref="module_category_car_rental" />
    </record>

    <!-- User Group -->
    <record id="car_rental_user_group" model="res.groups">
        <field name="name">User group</field>
        <field name="privilege_id" ref="car_rental_privilege" />
    </record>

    <!-- Manager Group -->
    <record id="car_rental_manager_group" model="res.groups">
        <field name="name">Manager group</field>
        <field name="privilege_id" ref="car_rental_privilege" />
        <field name="implied_ids"
            eval="[(4, ref('car_rental_user_group'))]" />
    </record>

    <!-- users need to see their own reservations  -->
    <record id="car_rental_reservation_user_rule" model="ir.rule">
        <field name="name">Users See Reservations Only</field>
        <field name="model_id" ref="model_car_rental_reservation" />
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups"
            eval="[(4, ref('car_rental_user_group'))]" />
    </record>

    <!-- manager sees all the reservations -->
    <record id="car_rental_reservation_manager_rule" model="ir.rule">
        <field name="name">Managers Sees All Reservations</field>
        <field name="model_id" ref="model_car_rental_reservation" />
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups"
            eval="[(4, ref('car_rental_manager_group'))]" />
    </record>

</odoo>