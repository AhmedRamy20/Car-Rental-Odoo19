<odoo>


    <record id="rental_car_list_view" model="ir.ui.view">
        <field name="name">rental car list view</field>
        <field name="model">car.rental.car</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="car_model" />
                <field name="car_state" />
                <field name="car_brand" />
                <field name="license_plate" />
                <field name="manufacturing_year" />
            </list>
        </field>
    </record>


    <record id="rental_car_form_view" model="ir.ui.view">
        <field name="name">rental car form view</field>
        <field name="model">car.rental.car</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name" />
                        <field name="car_model" />
                        <field name="car_state" />
                        <field name="car_brand" />
                        <field name="license_plate" />
                        <field name="manufacturing_year" />
                        <field name="reservation_ids" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>


    <record id="rental_car_action" model="ir.actions.act_window">
        <field name="name">Cars list</field>
        <field name="res_model">car.rental.car</field>
    </record>

    <menuitem id="cars_list_menu" parent="rental_car_root_menu" name="Cars"
        action="rental_car_action" />
</odoo>