<odoo>


    <record id="rental_car_list_view" model="ir.ui.view">
        <field name="name">rental car list view</field>
        <field name="model">car.rental.car</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="car_model" />
                <field name="car_brand" />
                <field name="car_state" />
                <field name="manufacturing_year" />
                <field name="license_plate" />
            </list>
        </field>
    </record>


    <record id="rental_car_form_view" model="ir.ui.view">
        <field name="name">rental car form view</field>
        <field name="model">car.rental.car</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_reserve" string="Reserve this car" type="object"
                        class="btn-primary" invisible="car_state != 'available' or is_manager " />

                    <button name="action_damage" string="Mark as damaged" type="object"
                        class="btn-secondary" invisible="car_state != 'available' or not is_manager" />

                    <button name="action_restore_available" string="Restore to available"
                        type="object"
                        class="btn-primary" invisible="car_state != 'damaged' or not is_manager" />

                    <field name="car_state" widget="statusbar" />
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Ex: Toyota" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="car_model" />
                            <field name="car_brand" />
                        </group>
                        <group>
                            <field name="license_plate" />
                            <field name="manufacturing_year" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>


    <record id="rental_car_action" model="ir.actions.act_window">
        <field name="name">Cars list</field>
        <field name="res_model">car.rental.car</field>
    </record>

    <menuitem id="cars_list_menu" parent="rental_car_root_menu" name="Cars"
        action="rental_car_action" />
</odoo>